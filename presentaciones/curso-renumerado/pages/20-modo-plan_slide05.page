      align: [left, top]
      text: |
        <ul>
        <li>as deleted in the database. Then create a screen</li>
        <li>that shows all the recently deleted notes. From this</li>
        <li>screen, the user can undelete a note or permanently</li>
        <li>delete it."</li>
        </ul>
