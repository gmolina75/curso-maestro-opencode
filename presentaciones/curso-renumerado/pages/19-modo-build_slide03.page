      align: [left, top]
      text: |
        <ul>
        <li>Desarrollo de nuevas features</li>
        <li>Refactoring de código existente</li>
        <li>Bug fixing con contexto completo</li>
        <li>Creación de archivos nuevos</li>
        <li>Configuración de proyectos</li>
        </ul>
