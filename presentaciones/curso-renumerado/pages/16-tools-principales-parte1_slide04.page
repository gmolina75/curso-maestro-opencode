    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Ejemplo de edit</strong></p>
  - elementId: bullets
    elementType: text
    bounds: [80, 140, 1100, 480]
