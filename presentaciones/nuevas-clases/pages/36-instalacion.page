pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Instalación</strong></p>
  - elementId: code
    elementType: text
    bounds: [80, 140, 1100, 200]
    content:
      style: "$code"
      align: [left, top]
      text: |
        <p># macOS</p>
        <p>brew install --cask opencode</p>
        <p></p>
        <p># Windows (próximamente)</p>
        <p># Descargar desde opencode.ai/download</p>
        <p></p>
        <p># Linux (AppImage)</p>
        <p>wget opencode.ai/download/linux -O opencode.AppImage</p>
  - elementId: bullets
    elementType: text
    bounds: [80, 360, 1100, 260]
    content:
      style: "$bullet"
      align: [left, top]
      text: |
        <ul>
        <li>Requiere tener instalado el CLI previamente</li>
        <li>Comparte configuración con TUI</li>
        <li>Actualizaciones automáticas vía autoupdate</li>
        </ul>
