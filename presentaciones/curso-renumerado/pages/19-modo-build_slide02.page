    elementType: text
    bounds: [80, 140, 1100, 480]
    content:
      style: "$bullet"
      align: [left, top]
      text: |
        <ul>
        <li>Modo por defecto de OpenCode</li>
        <li>Acceso completo a todas las herramientas</li>
        <li>Lectura, escritura y edición de archivos</li>
        <li>Ejecución de comandos shell</li>
        <li>Búsqueda en el codebase</li>
        </ul>
