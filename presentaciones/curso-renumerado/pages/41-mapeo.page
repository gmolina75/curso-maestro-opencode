pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Mapeo de Funcionalidades</strong></p>
  - elementId: table
    elementType: table
    bounds: [80, 140, 1120, 360]
    columnWidths: [0.25, 0.25, 0.25, 0.25]
    rowHeights: [0.16, 0.21, 0.21, 0.21, 0.21]
    style:
      headerFill: "$primary"
      headerColor: "#FFFFFF"
      headerBold: true
      bodyFill: ["$lightGray", "#FFFFFF"]
      border:
        style: solid
        width: 1
        color: "$border"
    rows:
      - - content: {text: "Función"}
        - content: {text: "Claude Code"}
        - content: {text: "Cursor"}
        - content: {text: "OpenCode"}
      - - content: {text: "Modo solo lectura"}
        - content: {text: "--"}
        - content: {text: "Chat mode"}
        - content: {text: "Plan mode"}
      - - content: {text: "Modo escritura"}
        - content: {text: "Default"}
        - content: {text: "Agent/Composer"}
        - content: {text: "Build mode"}
      - - content: {text: "Contexto proyecto"}
        - content: {text: "CLAUDE.md"}
        - content: {text: ".cursorrules"}
        - content: {text: "AGENTS.md"}
      - - content: {text: "Shortcuts"}
        - content: {text: "Ctrl+J"}
        - content: {text: "Ctrl+L/I"}
        - content: {text: "Ctrl+X"}
