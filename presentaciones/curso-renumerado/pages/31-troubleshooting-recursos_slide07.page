pageType: final
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Resumen</strong></p>
  - elementId: checks
    elementType: text
    bounds: [80, 160, 1100, 420]
    content:
      style: "$check"
      align: [left, top]
      text: |
        <p><span style="color:$accent;">✓</span> Problemas comunes tienen soluciones simples</p>
        <p><span style="color:$accent;">✓</span> Comandos de debug para diagnóstico</p>
        <p><span style="color:$accent;">✓</span> Comunidad activa para soporte</p>
        <p><span style="color:$accent;">✓</span> Mantener actualizado es importante</p>
