pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Comandos de Proveedor</strong></p>
  - elementId: bullets
    elementType: text
    bounds: [80, 140, 1100, 480]
    content:
      style: "$bullet"
      align: [left, top]
      text: |
        <ul>
        <li>/connect: Agregar/actualizar credenciales</li>
        <li>/models: Cambiar modelo activo</li>
        <li>Acceso rápido desde el TUI</li>
        </ul>
