pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Diferencias con TUI</strong></p>
  - elementId: table
    elementType: table
    bounds: [80, 140, 1120, 360]
    columnWidths: [0.33, 0.33, 0.34]
    rowHeights: [0.16, 0.21, 0.21, 0.21, 0.21]
    style:
      headerFill: "$primary"
      headerColor: "#FFFFFF"
      headerBold: true
      bodyFill: ["$lightGray", "#FFFFFF"]
      border:
        style: solid
        width: 1
        color: "$border"
    rows:
      - - content: {text: "Característica"}
        - content: {text: "TUI"}
        - content: {text: "Desktop"}
      - - content: {text: "Interfaz"}
        - content: {text: "Terminal"}
        - content: {text: "Gráfica nativa"}
      - - content: {text: "Atajos"}
        - content: {text: "Ctrl+X leader"}
        - content: {text: "Cmd/Ctrl nativos"}
      - - content: {text: "Imágenes"}
        - content: {text: "Drag & drop"}
        - content: {text: "Drag & drop + clipboard"}
      - - content: {text: "Recursos"}
        - content: {text: "Ligero"}
        - content: {text: "Mayor consumo"}
