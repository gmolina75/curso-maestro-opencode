      align: [left, top]
      text: |
        <ul>
        <li>1. Ejecutar opencode en terminal</li>
        <li>2. Ejecutar /connect</li>
        <li>3. Seleccionar OpenCode Zen</li>
        <li>4. Seguir instrucciones en navegador</li>
        <li>5. Pegar API key</li>
        <li>6. Ejecutar /models para ver modelos</li>
        </ul>
