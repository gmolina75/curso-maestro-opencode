pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Más Atajos</strong></p>
  - elementId: bullets
    elementType: text
    bounds: [80, 140, 1100, 480]
    content:
      style: "$bullet"
      align: [left, top]
      text: |
        <ul>
        <li>Ctrl+X M: Modelos</li>
        <li>Ctrl+X E: Editor</li>
        <li>Ctrl+X I: Init</li>
        <li>Ctrl+X D: Detalles</li>
        <li>Ctrl+X Q: Salir</li>
        <li>Ctrl+P: Paleta de comandos</li>
        <li>Tab: Cambiar modo Build/Plan</li>
        </ul>
