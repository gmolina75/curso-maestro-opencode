pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Elegir Modelos por Costo/Beneficio</strong></p>
  - elementId: table
    elementType: table
    bounds: [80, 140, 1120, 360]
    columnWidths: [0.30, 0.25, 0.45]
    rowHeights: [0.16, 0.168, 0.168, 0.168, 0.168, 0.168]
    style:
      headerFill: "$primary"
      headerColor: "#FFFFFF"
      headerBold: true
      bodyFill: ["$lightGray", "#FFFFFF"]
      border:
        style: solid
        width: 1
        color: "$border"
    rows:
      - - content: {text: "Tarea"}
        - content: {text: "Modelo Ideal"}
        - content: {text: "Por qué"}
      - - content: {text: "Refactor complejo"}
        - content: {text: "Claude Opus"}
        - content: {text: "Mejor razonamiento, vale el costo"}
      - - content: {text: "Bug simple"}
        - content: {text: "Haiku / GPT-4o-mini"}
        - content: {text: "Rápido y barato"}
      - - content: {text: "Tests"}
        - content: {text: "Qwen-Coder"}
        - content: {text: "Especializado, bajo costo"}
      - - content: {text: "Docs / Explicar"}
        - content: {text: "Sonnet / Gemini"}
        - content: {text: "Buen balance"}
      - - content: {text: "CI/CD"}
        - content: {text: "Local / Go"}
        - content: {text: "Sin costo de API"}
