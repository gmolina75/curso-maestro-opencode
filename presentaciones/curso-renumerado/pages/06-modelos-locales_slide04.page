        <p># LM Studio ejecuta en puerto 1234</p>
        <p>{</p>
        <p>  "provider": {</p>
        <p>    "lmstudio": {</p>
        <p>      "npm": "@ai-sdk/openai-compatible",</p>
        <p>      "name": "LM Studio (local)",</p>
        <p>      "options": {</p>
        <p>        "baseURL": "http://127.0.0.1:1234/v1"</p>
        <p>      },</p>
        <p>      "models": {</p>
        <p>        "google/gemma-3n-e4b": {</p>
        <p>          "name": "Gemma 3n-e4b (local)"</p>
        <p>        }</p>
        <p>      }</p>
        <p>    }</p>
        <p>  }</p>
        <p>}</p>
