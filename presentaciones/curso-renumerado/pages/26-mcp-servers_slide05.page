pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>OAuth para MCP Remoto</strong></p>
  - elementId: bullets
    elementType: text
    bounds: [80, 140, 1100, 480]
    content:
      style: "$bullet"
      align: [left, top]
      text: |
        <ul>
        <li>Detección automática de 401</li>
        <li>Dynamic Client Registration</li>
        <li>Tokens en ~/.local/share/opencode/</li>
        <li>Comandos: mcp auth, list, logout, debug</li>
        </ul>
