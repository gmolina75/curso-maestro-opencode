      align: [left, top]
      text: |
        <ul>
        <li>Plan de suscripción de bajo costo</li>
        <li>Modelos de código abierto populares</li>
        <li>Acceso confiable a modelos probados</li>
        <li>Misma configuración que Zen</li>
        </ul>
