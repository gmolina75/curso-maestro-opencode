pageType: cover
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [140, 240, 1000, 80]
    content:
      style: "$title"
      align: [center, middle]
      text: |
        <p><strong>Clase 37: Optimización de Costos</strong></p>
  - elementId: subtitle
    elementType: text
    bounds: [140, 340, 1000, 40]
    content:
      style: "$subtitle"
      align: [center, middle]
      text: |
        <p>Módulo 37 | Duración: 1 hora</p>
  - elementId: deco-line
    elementType: shape
    bounds: [540, 400, 200, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
