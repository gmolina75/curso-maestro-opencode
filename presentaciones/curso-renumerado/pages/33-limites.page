pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Límites de Contexto por Proveedor</strong></p>
  - elementId: table
    elementType: table
    bounds: [80, 140, 1120, 360]
    columnWidths: [0.35, 0.30, 0.35]
    rowHeights: [0.16, 0.168, 0.168, 0.168, 0.168, 0.168]
    style:
      headerFill: "$primary"
      headerColor: "#FFFFFF"
      headerBold: true
      bodyFill: ["$lightGray", "#FFFFFF"]
      border:
        style: solid
        width: 1
        color: "$border"
    rows:
      - - content: {text: "Modelo"}
        - content: {text: "Contexto"}
        - content: {text: "Notas"}
      - - content: {text: "Claude Sonnet 4"}
        - content: {text: "200K tokens"}
        - content: {text: "Ideal para código grande"}
      - - content: {text: "GPT-4o"}
        - content: {text: "128K tokens"}
        - content: {text: "Buen balance"}
      - - content: {text: "Gemini Pro"}
        - content: {text: "1M tokens"}
        - content: {text: "Máximo contexto"}
      - - content: {text: "Llama 3 (local)"}
        - content: {text: "8K-128K"}
        - content: {text: "Depende de config"}
      - - content: {text: "Haiku / pequeños"}
        - content: {text: "4K-32K"}
        - content: {text: "Tareas simples"}
