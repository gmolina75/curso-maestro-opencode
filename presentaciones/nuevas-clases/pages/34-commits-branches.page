pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Commits y Branches</strong></p>
  - elementId: code
    elementType: text
    bounds: [80, 140, 1100, 240]
    content:
      style: "$code"
      align: [left, top]
      text: |
        <p># Crear branch para feature</p>
        <p>git checkout -b feature/auth-refactor</p>
        <p></p>
        <p># Después de cambios de OpenCode</p>
        <p>git add .</p>
        <p>git commit -m "refactor: extract auth logic"</p>
        <p></p>
        <p># O dejar que OpenCode haga el commit</p>
        <p>"Create a commit with a descriptive message"</p>
  - elementId: bullets
    elementType: text
    bounds: [80, 400, 1100, 220]
    content:
      style: "$bullet"
      align: [left, top]
      text: |
        <ul>
        <li>Trabajar en branches protege el código principal</li>
        <li>OpenCode puede sugerir mensajes de commit</li>
        <li>Revisar siempre antes de hacer push</li>
        </ul>
