pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: title
    elementType: text
    bounds: [80, 50, 1120, 60]
    content:
      style: "$title"
      align: [left, middle]
      text: |
        <p><strong>Uso en GitHub</strong></p>
  - elementId: bullets
    elementType: text
    bounds: [80, 140, 1100, 480]
    content:
      style: "$bullet"
      align: [left, top]
      text: |
        <ul>
        <li>/opencode explain this issue</li>
        <li>/opencode fix this</li>
        <li>/oc delete attachment</li>
        <li>Comentarios en líneas de código</li>
        </ul>
