      style: "$bullet"
      align: [left, top]
      text: |
        <ul>
        <li>// Cambiar nombre de función</li>
        <li>oldString: "function calculateTotal(items)"</li>
        <li>newString: "function computeTotal(items)"</li>
        </ul>
